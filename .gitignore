# ==============================================================================
# Indian Sign Language AI — .gitignore
# ==============================================================================

# ── 1. Python Environment & Dependencies ──
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── 2. Python Bytecode & Cache ──
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# ── 3. Training Logs & Visual Plots ──
# TensorBoard training logs
logs/
# Evaluation metric plots generated by model_training.py
accuracy_plot.png
loss_plot.png
confusion_matrix.png

# ── 4. Raw & Heavy Datasets ──
# Raw video/image archives from external sources
archive/
# Legacy 1662-dimensional keypoint dataset
NP_Data/

# NOTE on NP_Data_Combined/:
# If you want to keep the repository lightweight (< 50MB) and share datasets
# via Google Drive/Kaggle instead of Git, uncomment the line below:
# NP_Data_Combined/

# ── 5. Large Model Checkpoints & Weights ──
# Uncomment if you want to distribute models via GitHub Releases instead of Git:
# *.h5
# *.keras
# hand_landmarker.task

# ── 6. Operating System & Editor Files ──
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ── 7. Temporary & Scratch Files ──
*.log
*.tmp
*.bak
